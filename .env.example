APP_NAME=Alpha Business News Analytics API
DATABASE_URL=sqlite:///./data/alpha_hack.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RSS_FEEDS=https://www.cbr.ru/rss/RssNews,https://www.cbr.ru/rss/eventrss
REQUEST_TIMEOUT_SECONDS=8
MAX_FEED_ITEMS=30
# Set a non-empty secret to protect POST /api/news/refresh with X-Refresh-Token.
NEWS_REFRESH_TOKEN=
# Add the approved provider endpoint and key to .env for AI analysis.
LLM_API_KEY=
LLM_BASE_URL=
# Organizer CSV data shipped in data/sample/.
COMPANIES_CSV_PATH=data/sample/df_Uid_data_hack.csv
PAYMENTS_CSV_PATH=data/sample/df_Uid_payment_hack.csv
PERSON_LINKS_CSV_PATH=data/sample/df_Fid_Uid_link_hack.csv
